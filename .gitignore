# Dependencies
node_modules/
**/node_modules/

# Production build outputs
dist/
**/dist/
build/
**/build/

# Environment and sensitive keys
.env
.env.*
!.env.example

# Temporary files, logs, and backups
logs/*.log
*.log
*.bak
*.backup
*.tmp
*.tsbuildinfo
__pycache__/
